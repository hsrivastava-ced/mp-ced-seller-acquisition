function renderBD() {
  const prog = curProg();
  const bdInc = 100;
  const bdMap = {};
  curSellers().forEach(s => {
    if (!s.associate) return;
    const a = s.associate.trim();
    if (!bdMap[a]) bdMap[a] = {r:0,c:0};
    bdMap[a].r++;
    if ((s.status||'').toUpperCase().includes('ONBOARD')) bdMap[a].c++;
  });
  const rows = Object.entries(bdMap).sort((a,b)=>b[1].c-a[1].c);
  const totalC = rows.reduce((a,r)=>a+r[1].c,0);

  document.getElementById('bd-metrics').innerHTML = `
    <div class="mcard"><div class="ml">Active associates</div><div class="mv">${rows.length}</div></div>
    <div class="mcard teal"><div class="ml">Total referrals</div><div class="mv">${rows.reduce((a,r)=>a+r[1].r,0)}</div></div>
    <div class="mcard green"><div class="ml">Completions</div><div class="mv">${totalC}</div></div>
    <div class="mcard amber"><div class="ml">Incentives due</div><div class="mv">$${totalC*bdInc}</div><div class="ms">$${bdInc} per completion</div></div>
  `;
  document.getElementById('bd-inc-sub').textContent = '$' + bdInc + ' per BD-referred seller who goes live';
  document.getElementById('bd-tbody').innerHTML = rows.map(([n,d]) =>
    '<tr><td><strong>'+n+'</strong></td><td>'+d.r+'</td><td>'+d.c+'</td><td>'+(d.r?Math.round(d.c/d.r*100)+'%':'—')+'</td><td style="font-weight:600;color:var(--green)">'+(d.c?'$'+(d.c*bdInc):'—')+'</td></tr>'
  ).join('') || '<tr><td colspan="5" style="text-align:center;padding:18px;color:var(--t3)">No associates yet</td></tr>';

  document.getElementById('bd-inc-list').innerHTML = curQualified().map(q =>
    '<div class="rev-row"><div><div style="font-size:13px;font-weight:500">'+q.store_name+'</div><div style="font-size:11px;color:var(--t3)">'+(q.bda||'—')+' · '+fmtM(q.first_sale_month)+'</div></div>' +
    '<span class="'+(q.bd_incentive==='paid'?'paid':'pend')+'">'+(q.bd_incentive==='paid'?'$'+bdInc+' paid':'Pending')+'</span></div>'
  ).join('') || '<div style="color:var(--t3);font-size:13px;padding:8px">No qualified sellers yet</div>';
}

// ============================================================
// IMPORT
// ============================================================
async function runImport() {
  const raw = document.getElementById('imp-emails').value;
  const src = document.getElementById('imp-src').value;
  const progId = document.getElementById('imp-prog').value;
  const label = document.getElementById('imp-label').value.trim();
  const emails = raw.split('\n').map(e=>e.trim().toLowerCase()).filter(e=>e&&e.includes('@')&&e.includes('.'));
  if (!emails.length) { alert('No valid emails found'); return; }
  let added=0, updated=0, skipped=0;
  const toInsert=[], toUpdate=[];
  emails.forEach(email => {
    const ex = SELLERS.find(s=>(s.email||'').toLowerCase()===email && s.program_id===progId);
    if (ex) { if (!(ex.sources||[]).includes(src)) { toUpdate.push({id:ex.id, sources:[...new Set([...(ex.sources||[]),src])]}); updated++; } else skipped++; }
    else { toInsert.push({id:uid(),email,program_id:progId,status:'EMAIL FOLLOW UP IN PROGRESS',sources:[src],tags:[],campaign:label||undefined}); added++; }
  });
  try {
    if (toInsert.length) { await DB.from('sellers').insert(toInsert); SELLERS.unshift(...toInsert); }
    for (const u of toUpdate) { await DB.from('sellers').update(u.id, {sources:u.sources}); const s=SELLERS.find(x=>x.id===u.id); if(s) s.sources=u.sources; }
    document.getElementById('imp-emails').value='';
    document.getElementById('imp-result').innerHTML='<div class="info-box green">Done: '+added+' new · '+updated+' updated · '+skipped+' already had source</div>';
    if (MQL_EMAILS.length===0 && src==='MQL') { MQL_EMAILS=[...emails]; localStorage.setItem('ced_mql_emails',JSON.stringify(MQL_EMAILS)); }
    toast('Imported '+emails.length+' emails');
  } catch(e) { toast('Error: '+e.message, true); }
}

async function runCSVImport() {
  const raw = document.getElementById('imp-csv').value.trim();
  if (!raw) { alert('Paste CSV data first'); return; }
  const lines = raw.split('\n');
  const hdr = lines[0].split(',').map(h=>h.trim().toLowerCase().replace(/[^a-z]/g,''));
  const eI=hdr.findIndex(h=>h.includes('email'));
  const coI=hdr.findIndex(h=>h.includes('store')||h.includes('company'));
  const stI=hdr.findIndex(h=>h.includes('status'));
  const srI=hdr.findIndex(h=>h.includes('source'));
  const asI=hdr.findIndex(h=>h.includes('associate'));
  const tgI=hdr.findIndex(h=>h.includes('tag'));
  const sdI=hdr.findIndex(h=>h.includes('storeid')||h.includes('mallid'));
  if (eI<0&&sdI<0) { alert('Need at least Email or StoreID column'); return; }
  const progId = document.getElementById('imp-prog').value;
  let added=0, updated=0;
  const toInsert=[];
  lines.slice(1).forEach(line => {
    if (!line.trim()) return;
    const cols = line.split(',').map(c=>c.trim().replace(/^"|"$/g,''));
    const email = eI>=0?(cols[eI]||'').toLowerCase().trim():'';
    const storeId = sdI>=0?cols[sdI]:'';
    if (!email&&!storeId) return;
    const src = srI>=0?cols[srI]:'BD';
    const data = {id:uid(),email:email||null,company:coI>=0?cols[coI]:'',status:stI>=0?cols[stI]:'EMAIL FOLLOW UP IN PROGRESS',sources:[src],associate:asI>=0?cols[asI]:'',tags:tgI>=0&&cols[tgI]?cols[tgI].split(';').map(t=>t.trim()).filter(Boolean):[],store_id:storeId||null,program_id:progId,qualified:false,updated_at:new Date().toISOString()};
    if (data.status.toUpperCase().includes('ONBOARD')) data.qualified=true;
    toInsert.push(data); added++;
  });
  try {
    if (toInsert.length) { await DB.from('sellers').insert(toInsert); SELLERS.unshift(...toInsert); }
    document.getElementById('imp-csv').value='';
    document.getElementById('csv-result').innerHTML='<div class="info-box green">CSV import: '+added+' new sellers</div>';
    toast('CSV imported');
  } catch(e) { toast('Error: '+e.message, true); }
}

function handleDrop(e) {
  e.preventDefault(); e.currentTarget.classList.remove('drag');
  const file = e.dataTransfer.files[0]; if(!file) return;
  if (file.name.endsWith('.csv')||file.type==='text/csv') {
    const r=new FileReader(); r.onload=ev=>{document.getElementById('imp-csv').value=ev.target.result; toast('CSV loaded');};r.readAsText(file);
  } else toast('Use CSV format');
}

function exportCSV() {
  const sellers = curSellers();
  const h = ['Email','Store','Status','Tags','Sources','Associate','Mall ID','Phone','Website','Program','Updated','Remarks'];
  const rows = sellers.map(s=>[s.email||'',s.company||'',s.status||'',(s.tags||[]).join(';'),(s.sources||[]).join(';'),s.associate||'',s.store_id||'',s.phone||'',s.website||'',PROGRAMS.find(p=>p.id===s.program_id)?.name||'',s.updated_at?new Date(s.updated_at).toLocaleDateString('en-GB'):'',s.remarks||''].map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(','));
  const a=document.createElement('a');
  a.href='data:text/csv;charset=utf-8,\uFEFF'+encodeURIComponent([h.join(','),...rows].join('\n'));
  a.download='ced_sellers_'+new Date().toISOString().slice(0,10)+'.csv';
  a.click(); toast('CSV exported');
}

