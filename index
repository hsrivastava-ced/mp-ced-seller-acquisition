  if (EDIT_ID) {
    const prev = SELLERS.find(s => s.id===EDIT_ID);
    sources = prev ? [...new Set([...(prev.sources||[]), srcVal])] : [srcVal];
  }
  const data = {
    email: email || null,
    company: document.getElementById('f-company').value,
    store_id: storeId || null,
    phone: document.getElementById('f-phone').value,
    website: document.getElementById('f-website').value,
    remarks: document.getElementById('f-remarks').value,
    status: document.getElementById('f-status').value,
    associate: document.getElementById('f-assoc').value,
    program_id: document.getElementById('f-prog').value,
    tags: SEL_TAGS,
    sources,
    qualified: (document.getElementById('f-status').value||'').toUpperCase().includes('ONBOARD'),
    updated_at: new Date().toISOString()
  };
  document.getElementById('save-seller-btn').disabled = true;
  try {
    if (EDIT_ID) {
      await DB.from('sellers').update(EDIT_ID, data);
      const idx = SELLERS.findIndex(s=>s.id===EDIT_ID);
      if (idx>=0) SELLERS[idx] = {...SELLERS[idx], ...data};
    } else {
      data.id = uid();
      const res = await DB.from('sellers').insert(data);
      SELLERS.unshift(res ? res[0] : {...data});
    }
    closeModal('m-seller');
    renderView();
    toast(EDIT_ID ? 'Seller updated' : 'Seller added');
  } catch(e) { toast('Error: ' + e.message, true); }
  finally { document.getElementById('save-seller-btn').disabled = false; }
}

