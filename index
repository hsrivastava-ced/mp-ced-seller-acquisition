async function sbFetch(path, method='GET', body=null) {
  const opts = {
    method,
    headers: { 'Content-Type':'application/json', 'apikey': SB_KEY, 'Authorization': 'Bearer ' + SB_KEY, 'Prefer': method==='POST'?'return=representation':'return=minimal' }
  };
  if (body) opts.body = JSON.stringify(body);
  const r = await fetch(SB_URL + '/rest/v1/' + path, opts);
  if (!r.ok) {
    const err = await r.text();
    throw new Error(err);
  }
  const txt = await r.text();
  return txt ? JSON.parse(txt) : null;
}

const DB = {
  from: (table) => ({
    select: (cols='*') => sbFetch(`${table}?select=${cols}`),
    selectEq: (cols, col, val) => sbFetch(`${table}?select=${cols}&${col}=eq.${encodeURIComponent(val)}`),
    insert: (data) => sbFetch(table, 'POST', Array.isArray(data) ? data : [data]),
    update: (id, data) => sbFetch(`${table}?id=eq.${id}`, 'PATCH', data),
    delete: (id) => sbFetch(`${table}?id=eq.${id}`, 'DELETE'),
