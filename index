const uid = () => crypto.randomUUID ? crypto.randomUUID() : 'x' + Math.random().toString(36).slice(2,11);
const now = () => new Date().toLocaleDateString('en-GB');
function fmtM(m) {
  if (!m) return '—';
  const [y, mo] = m.split('-');
  const mths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return mths[parseInt(mo)-1] + ' ' + (y > '2025' ? "'" + y.slice(2) : y);
}
function toast(msg, isError=false) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show' + (isError ? ' error' : '');
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), 2800);
}
function loading(show, text='Saving...') {
  document.getElementById('loading').classList.toggle('hidden', !show);
  if (text) document.getElementById('loading-text').textContent = text;
}
function setDBStatus(state) {
  const dot = document.getElementById('db-dot');
  const lbl = document.getElementById('db-label');
  dot.className = 'db-dot ' + (state==='ok'?'':'loading' );
  if (state==='ok') { dot.style.background='#22c55e'; lbl.textContent='Database connected'; }
  else if (state==='err') { dot.style.background='#ef4444'; lbl.textContent='Database error'; }
  else { dot.style.background=PROG_COLORS.amber; lbl.textContent='Connecting...'; }
}

function sPill(s) {
  if (!s) return '<span class="pill p-gray">—</span>';
  const u = s.toUpperCase();
  let c = 'p-gray';
  if (u.includes('ONBOARD')) c='p-green';
  else if (u.includes('EMAIL FOLLOW')) c='p-blue';
  else if (u.includes('WHATSAPP')) c='p-teal';
  else if (u.includes('REGISTRATION')||u.includes('SIGN UP')) c='p-purple';
  else if (u.includes('NOT INTEREST')||u.includes('STUCK')||u.includes('NOT ELIG')) c='p-red';
  else if (u.includes('DOCUMENT')||u.includes('INCOMMUNICATION')) c='p-amber';
  else if (u.includes('PRODUCT')||u.includes('LISTING')||u.includes('SALES')) c='p-blue';
  const lbl = s.length > 24 ? s.slice(0,24)+'...' : s;
  return '<span class="pill ' + c + '">' + lbl + '</span>';
}

function srcTags(sources) {
  return (sources||[]).map(s => {
    const sl = s.toLowerCase();
    const c = sl.includes('temu')?'stag-temu':sl.includes('bd')?'stag-bd':sl.includes('mql')||sl.includes('quality')||sl.includes('crm')?'stag-mql':sl.includes('newsletter')?'stag-nl':'stag-camp';
    return '<span class="stag ' + c + '">' + s + '</span>';
  }).join('');
}

function tagChips(tags) {
  return (tags||[]).map(t => '<span class="tchip ' + (TAG_CLS[t]||'t-def') + '">' + t + '</span>').join('');
}

function curProg() { return PROGRAMS.find(p => p.id === CUR_PROG) || {}; }
function progCurr() { return CURRENCIES[curProg().currency] || '€'; }
function curSellers() { return SELLERS.filter(s => s.program_id === CUR_PROG); }
function curQualified() { return QUALIFIED.filter(q => q.program_id === CUR_PROG); }
function curPayments() { return PAYMENTS.filter(p => p.program_id === CUR_PROG); }
