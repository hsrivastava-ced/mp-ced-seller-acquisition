<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Seller Acquisition — CedCommerce</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --navy:#0f1b2d; --navy2:#162236; --navy3:#1d2e47;
  --line:rgba(255,255,255,0.07); --line2:rgba(255,255,255,0.13);
  --twht:#e8e2d8; --twht2:#a8b4c4;
  --bg:#f0ede8; --surf:#f7f4f0; --surf2:#ebe7e1; --surf3:#e2ddd6;
  --bdr:rgba(0,0,0,0.09); --bdr2:rgba(0,0,0,0.15);
  --t1:#1a1610; --t2:#5a5448; --t3:#8a8278;
  --teal:#0d9488; --teal2:#0f766e; --teal-l:#ccfbf1; --teal-t:rgba(13,148,136,0.12);
  --green:#16a34a; --green-l:#dcfce7;
  --amber:#d97706; --amber-l:#fef3c7;
  --red:#dc2626; --red-l:#fee2e2;
  --blue:#2563eb; --blue-l:#dbeafe;
  --purple:#7c3aed; --purple-l:#ede9fe;
  --r:10px; --rs:6px;
  --font:'DM Sans',sans-serif; --mono:'DM Mono',monospace;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:var(--font);background:var(--bg);color:var(--t1);font-size:14px;min-height:100vh;-webkit-font-smoothing:antialiased;}
.shell{display:flex;min-height:100vh;}

/* SIDEBAR */
.sidebar{width:230px;background:var(--navy);display:flex;flex-direction:column;flex-shrink:0;position:sticky;top:0;height:100vh;overflow-y:auto;}
.slogo{padding:20px 18px 14px;border-bottom:1px solid var(--line);}
.slogo-mark{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;background:var(--teal);border-radius:8px;margin-bottom:10px;}
.slogo-mark svg{width:18px;height:18px;color:#fff;}
.brand{font-size:15px;font-weight:600;color:#fff;letter-spacing:-.01em;}
.sub{font-size:11px;color:var(--twht2);margin-top:2px;}
.nsec{padding:8px 0;}
.nlabel{font-size:10px;font-weight:500;color:rgba(168,180,196,0.5);letter-spacing:.1em;text-transform:uppercase;padding:8px 18px 5px;}
.ni{display:flex;align-items:center;gap:10px;padding:9px 18px;cursor:pointer;color:var(--twht2);font-size:13px;border-left:2px solid transparent;transition:all .13s;}
.ni:hover{background:var(--navy3);color:var(--twht);}
.ni.active{background:var(--teal-t);color:#5eead4;border-left-color:var(--teal);font-weight:500;}
.ni svg{width:15px;height:15px;flex-shrink:0;opacity:.8;}
.ni.active svg{opacity:1;}
.psw{padding:6px 12px;}
.pbtn{display:flex;align-items:center;gap:8px;width:100%;padding:8px 10px;margin-bottom:3px;border-radius:var(--rs);border:1px solid var(--line);cursor:pointer;font-size:12px;font-family:var(--font);background:transparent;color:var(--twht2);text-align:left;transition:all .13s;}
.pbtn:hover{background:var(--navy3);color:var(--twht);border-color:var(--line2);}
.pbtn.active{background:var(--teal-t);color:#5eead4;border-color:rgba(13,148,136,.3);font-weight:500;}
.pdot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.addprog{display:flex;align-items:center;justify-content:center;gap:6px;width:100%;padding:7px;border-radius:var(--rs);border:1px dashed rgba(255,255,255,.18);cursor:pointer;font-size:12px;font-family:var(--font);color:var(--twht2);background:transparent;margin-top:4px;transition:all .13s;}
.addprog:hover{color:#5eead4;border-color:var(--teal);}
.sb-footer{margin-top:auto;padding:14px 18px;border-top:1px solid var(--line);}
.db-status{font-size:11px;color:var(--twht2);opacity:.6;display:flex;align-items:center;gap:5px;}
.db-dot{width:6px;height:6px;border-radius:50%;background:#22c55e;flex-shrink:0;}
.db-dot.offline{background:#ef4444;}
.db-dot.loading{background:var(--amber);}

/* MAIN */
.main{flex:1;overflow-y:auto;min-width:0;}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:13px 26px;background:var(--surf);border-bottom:1px solid var(--bdr);gap:12px;flex-wrap:wrap;position:sticky;top:0;z-index:40;}
.topbar-title{font-size:17px;font-weight:600;letter-spacing:-.02em;}
.topbar-sub{font-size:12px;color:var(--t3);margin-top:2px;}
.topbar-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.content{padding:22px 26px;}

/* BUTTONS */
.btn{padding:7px 14px;border-radius:var(--rs);border:1px solid var(--bdr2);cursor:pointer;font-size:13px;font-family:var(--font);background:var(--surf);color:var(--t2);transition:all .13s;white-space:nowrap;}
.btn:hover{background:var(--surf3);color:var(--t1);}
.btn:disabled{opacity:.4;cursor:not-allowed;}
.btn-teal{background:var(--teal);color:#fff;border-color:var(--teal);font-weight:500;}
.btn-teal:hover{background:var(--teal2);color:#fff;}
.btn-green{background:var(--green);color:#fff;border-color:var(--green);}
.btn-green:hover{background:#15803d;color:#fff;}
.btn-sm{padding:4px 10px;font-size:11px;}
.btn-icon{display:inline-flex;align-items:center;gap:5px;}

/* METRICS */
.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:12px;margin-bottom:20px;}
.mcard{background:var(--surf);border:1px solid var(--bdr);border-radius:var(--r);padding:15px 17px;position:relative;overflow:hidden;}
.mcard::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--bdr2);border-radius:var(--r) var(--r) 0 0;}
.mcard.teal::before{background:var(--teal);}
.mcard.green::before{background:var(--green);}
.mcard.amber::before{background:var(--amber);}
.mcard.blue::before{background:var(--blue);}
.mcard.purple::before{background:var(--purple);}
.mcard .ml{font-size:11px;color:var(--t3);letter-spacing:.03em;margin-bottom:7px;margin-top:2px;}
.mcard .mv{font-size:26px;font-weight:600;color:var(--t1);line-height:1;font-variant-numeric:tabular-nums;}
.mcard .ms{font-size:11px;color:var(--t3);margin-top:4px;}
.mcard.teal .mv{color:var(--teal2);}
.mcard.green .mv{color:var(--green);}
.mcard.amber .mv{color:var(--amber);}
.mcard.blue .mv{color:var(--blue);}
.mcard.purple .mv{color:var(--purple);}

/* CARDS */
.card{background:var(--surf);border:1px solid var(--bdr);border-radius:var(--r);padding:18px;margin-bottom:16px;}
.card-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:14px;gap:10px;flex-wrap:wrap;}
.card-title{font-size:14px;font-weight:600;letter-spacing:-.01em;}
.card-sub{font-size:12px;color:var(--t3);margin-top:2px;}

/* AFFILIATE LINK BOX */
.aff-box{background:var(--navy);border-radius:var(--r);padding:14px 16px;margin-bottom:16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
.aff-label{font-size:11px;color:var(--twht2);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;}
.aff-link{font-size:11px;font-family:var(--mono);color:#5eead4;word-break:break-all;max-width:500px;}
.aff-actions{display:flex;gap:8px;flex-shrink:0;}
.aff-btn{padding:5px 12px;border-radius:var(--rs);border:1px solid var(--line2);cursor:pointer;font-size:11px;font-family:var(--font);background:transparent;color:var(--twht);transition:all .13s;white-space:nowrap;}
.aff-btn:hover{background:var(--navy3);}

/* GRID */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
.g3{display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-bottom:16px;}

/* TABLE */
.tbl-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
th{font-size:11px;font-weight:500;color:var(--t3);text-transform:uppercase;letter-spacing:.06em;padding:9px 11px;text-align:left;border-bottom:1px solid var(--bdr);background:var(--surf2);white-space:nowrap;}
td{padding:9px 11px;border-bottom:1px solid var(--bdr);font-size:13px;vertical-align:middle;}
tr:last-child td{border-bottom:none;}
tr:hover td{background:var(--surf2);}

/* PILLS */
.pill{display:inline-flex;align-items:center;font-size:11px;font-weight:500;padding:3px 9px;border-radius:100px;white-space:nowrap;}
.p-green{background:var(--green-l);color:#15803d;}
.p-blue{background:var(--blue-l);color:#1d4ed8;}
.p-teal{background:var(--teal-l);color:var(--teal2);}
.p-amber{background:var(--amber-l);color:#92400e;}
.p-red{background:var(--red-l);color:#991b1b;}
.p-purple{background:var(--purple-l);color:#5b21b6;}
.p-gray{background:var(--surf3);color:var(--t2);}

/* SOURCE / TAG CHIPS */
.stag{display:inline-block;font-size:10px;font-family:var(--mono);padding:2px 6px;border-radius:4px;margin:1px;border:1px solid var(--bdr);}
.stag-temu{background:#dbeafe;color:#1d4ed8;border-color:#bfdbfe;}
.stag-bd{background:#fef3c7;color:#92400e;border-color:#fde68a;}
.stag-camp{background:var(--green-l);color:#166534;border-color:#bbf7d0;}
.stag-mql{background:var(--purple-l);color:#5b21b6;border-color:#ddd6fe;}
.stag-nl{background:var(--teal-l);color:var(--teal2);border-color:#99f6e4;}
.stag-def{background:var(--surf2);color:var(--t2);border-color:var(--bdr);}
.tchip{display:inline-flex;align-items:center;font-size:10px;font-weight:500;padding:2px 7px;border-radius:100px;margin:1px;}
.t-hot{background:#fee2e2;color:#991b1b;}
.t-vat{background:#fef3c7;color:#92400e;}
.t-noreply{background:var(--surf3);color:var(--t2);}
.t-doc{background:var(--purple-l);color:#5b21b6;}
.t-price{background:var(--blue-l);color:#1d4ed8;}
.t-list{background:var(--teal-l);color:var(--teal2);}
.t-tech{background:#fee2e2;color:#991b1b;}
.t-follow{background:var(--blue-l);color:var(--blue);}
.t-def{background:var(--surf3);color:var(--t2);}

/* OUTREACH BTNS */
.ob{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:var(--rs);border:1px solid var(--bdr2);cursor:pointer;font-size:11px;font-family:var(--font);background:var(--surf2);color:var(--blue);transition:all .12s;margin-right:3px;}
.ob:hover{background:var(--blue-l);}
.ob-wa{color:var(--teal2);}
.ob-wa:hover{background:var(--teal-l);}

/* PAYMENT */
.paid{display:inline-block;font-size:11px;font-weight:500;padding:2px 9px;border-radius:100px;background:var(--green-l);color:#15803d;}
.pend{display:inline-block;font-size:11px;font-weight:500;padding:2px 9px;border-radius:100px;background:var(--amber-l);color:#92400e;}
.rev-row{display:flex;align-items:flex-start;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--bdr);gap:8px;flex-wrap:wrap;}
.rev-row:last-child{border-bottom:none;}

/* SEARCH / FILTER */
.sbar{display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap;}
.sbar input,.sbar select{padding:8px 12px;border:1px solid var(--bdr2);border-radius:var(--rs);font-size:13px;font-family:var(--font);background:var(--surf);color:var(--t1);}
.sbar input{flex:1;min-width:200px;}
.sbar input:focus,.sbar select:focus{outline:none;border-color:var(--teal);}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;}
.chip{padding:4px 13px;border-radius:100px;border:1px solid var(--bdr2);font-size:12px;font-family:var(--font);cursor:pointer;color:var(--t2);background:transparent;transition:all .13s;}
.chip:hover{background:var(--surf3);color:var(--t1);}
.chip.active{background:var(--teal-t);color:var(--teal);border-color:rgba(13,148,136,.35);font-weight:500;}

/* FUNNEL */
.funnel-row{display:flex;align-items:center;gap:10px;margin-bottom:9px;}
.funnel-label{font-size:12px;color:var(--t2);min-width:195px;}
.funnel-track{flex:1;background:var(--surf2);border-radius:4px;height:20px;overflow:hidden;}
.funnel-fill{height:100%;border-radius:4px;}
.funnel-n{font-size:12px;font-weight:600;min-width:28px;text-align:right;font-variant-numeric:tabular-nums;}

/* CAMP CARDS */
.camp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;}
.ccard{background:var(--surf2);border:1px solid var(--bdr);border-radius:var(--rs);padding:13px;}
.ccard-title{font-size:12px;font-weight:600;margin-bottom:8px;padding-bottom:7px;border-bottom:1px solid var(--bdr);}
.cstat{display:flex;justify-content:space-between;font-size:12px;padding:2px 0;}
.cstat .l{color:var(--t3);}
.cstat .v{font-weight:600;font-variant-numeric:tabular-nums;}

/* MODAL */
.overlay{display:none;position:fixed;inset:0;background:rgba(15,27,45,.55);z-index:200;align-items:center;justify-content:center;}
.overlay.open{display:flex;}
.modal{background:var(--surf);border-radius:var(--r);border:1px solid var(--bdr);width:90%;max-width:560px;max-height:92vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.2);}
.modal-lg{max-width:700px;}
.mhead{padding:16px 20px 13px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;background:var(--surf2);border-radius:var(--r) var(--r) 0 0;}
.mhead h3{font-size:15px;font-weight:600;}
.mclose{background:none;border:none;font-size:20px;cursor:pointer;color:var(--t3);line-height:1;}
.mclose:hover{color:var(--t1);}
.mbody{padding:18px 20px;}
.mfoot{padding:13px 20px;border-top:1px solid var(--bdr);display:flex;justify-content:flex-end;gap:8px;}
.field{margin-bottom:12px;}
.field label{display:block;font-size:12px;font-weight:500;color:var(--t2);margin-bottom:4px;}
.field input,.field select,.field textarea{width:100%;padding:8px 11px;border:1px solid var(--bdr2);border-radius:var(--rs);font-size:13px;font-family:var(--font);background:var(--surf);color:var(--t1);}
.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--teal);}
.field textarea{resize:vertical;min-height:68px;}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:11px;}
.info-box{background:var(--surf2);border-left:3px solid var(--bdr2);border-radius:0 var(--rs) var(--rs) 0;padding:10px 13px;font-size:12px;color:var(--t2);margin-bottom:12px;line-height:1.6;}
.info-box.green{border-left-color:var(--green);background:var(--green-l);color:#15803d;}
.info-box.amber{border-left-color:var(--amber);background:var(--amber-l);color:#92400e;}
.info-box.teal{border-left-color:var(--teal);background:var(--teal-l);color:var(--teal2);}
.tag-picker{display:flex;flex-wrap:wrap;gap:6px;padding:10px;background:var(--surf2);border-radius:var(--rs);border:1px solid var(--bdr);}
.tag-opt{padding:3px 10px;border-radius:100px;font-size:11px;cursor:pointer;border:1px solid var(--bdr2);background:var(--surf);color:var(--t2);font-family:var(--font);transition:all .12s;}
.tag-opt.sel{border-color:var(--teal);background:var(--teal-t);color:var(--teal);}

/* IMPORT */
.imp-drop{border:2px dashed var(--bdr2);border-radius:var(--r);padding:24px;text-align:center;cursor:pointer;transition:all .18s;background:var(--surf2);}
.imp-drop:hover,.imp-drop.drag{border-color:var(--teal);background:var(--teal-l);}

/* VIEWS */
.view{display:none;}
.view.active{display:block;}

/* LOADING */
.loading-overlay{position:fixed;inset:0;background:rgba(15,27,45,.7);z-index:500;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;}
.loading-overlay.hidden{display:none;}
.spinner{width:36px;height:36px;border:3px solid rgba(255,255,255,.15);border-top-color:#5eead4;border-radius:50%;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.loading-text{color:var(--twht);font-size:13px;}

/* TOAST */
.toast{position:fixed;bottom:22px;right:22px;background:var(--navy);color:var(--twht);padding:11px 17px;border-radius:var(--rs);font-size:13px;z-index:999;opacity:0;transform:translateY(8px);transition:all .18s;pointer-events:none;border:1px solid var(--navy3);}
.toast.show{opacity:1;transform:translateY(0);}
.toast.error{border-color:var(--red);color:#fca5a5;}

/* SETUP SCREEN */
.setup-screen{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:24px;}
.setup-card{background:var(--surf);border:1px solid var(--bdr);border-radius:var(--r);padding:32px;max-width:560px;width:100%;}
.setup-card h2{font-size:20px;font-weight:600;margin-bottom:6px;}
.setup-card p{font-size:13px;color:var(--t2);line-height:1.7;margin-bottom:20px;}
.setup-step{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--bdr);}
.setup-step:last-child{border:none;}
.step-num{width:24px;height:24px;border-radius:50%;background:var(--teal);color:#fff;font-size:12px;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
.step-body{font-size:13px;color:var(--t2);line-height:1.6;}
.step-body strong{color:var(--t1);}
.step-body code{font-family:var(--mono);background:var(--surf2);padding:1px 5px;border-radius:3px;font-size:12px;}

/* OVERLAP DOT */
.ovr{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--amber);margin-right:4px;}

::-webkit-scrollbar{width:5px;height:5px;}
::-webkit-scrollbar-thumb{background:var(--bdr2);border-radius:3px;}
@media(max-width:960px){.g2,.g3{grid-template-columns:1fr;}}
@media print{.sidebar,.topbar-actions,.overlay{display:none!important;}}
</style>
</head>
<body>

<!-- LOADING OVERLAY -->
<div class="loading-overlay" id="loading">
  <div class="spinner"></div>
  <div class="loading-text" id="loading-text">Connecting to database...</div>
</div>

<!-- SETUP SCREEN (shown if no Supabase keys configured) -->
<div class="setup-screen" id="setup-screen" style="display:none;">
  <div class="setup-card">
    <div style="display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;background:var(--teal);border-radius:10px;margin-bottom:16px;">
      <svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="1.8"><path d="M10 2L2 6v8l8 4 8-4V6L10 2z"/><path d="M10 2v18M2 6l8 4 8-4"/></svg>
    </div>
    <h2>CedCommerce Acquisition Hub</h2>
    <p>This app stores all data in a shared Supabase database so your whole team works from the same live data. One-time setup takes 5 minutes.</p>
    <div class="setup-step">
      <div class="step-num">1</div>
      <div class="step-body"><strong>Create free Supabase account</strong><br>Go to <a href="https://supabase.com" target="_blank" style="color:var(--teal)">supabase.com</a> → New project → name it <code>ced-acquisition</code></div>
    </div>
    <div class="setup-step">
      <div class="step-num">2</div>
      <div class="step-body"><strong>Run the SQL schema</strong><br>In your project → SQL Editor → paste and run the schema from the <code>setup_schema.sql</code> file provided with this app</div>
    </div>
    <div class="setup-step">
      <div class="step-num">3</div>
      <div class="step-body"><strong>Enter your project credentials</strong><br>Settings → API → copy Project URL and anon/public key below</div>
    </div>
    <div class="field" style="margin-top:16px;"><label>Supabase Project URL</label><input id="setup-url" placeholder="https://xxxxx.supabase.co"></div>
    <div class="field"><label>Supabase Anon (public) Key</label><input id="setup-key" placeholder="eyJhbGc..."></div>
    <button class="btn btn-teal" style="width:100%;padding:11px;margin-top:4px;" onclick="saveSetup()">Connect & initialise database</button>
    <div id="setup-msg" style="margin-top:12px;"></div>
  </div>
</div>

<!-- MAIN APP -->
<div class="shell" id="app" style="display:none;">
<aside class="sidebar">
  <div class="slogo">
    <div class="slogo-mark"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 2L2 6v8l8 4 8-4V6L10 2z"/><path d="M10 2v18M2 6l8 4 8-4"/></svg></div>
    <div class="brand">CedCommerce</div>
    <div class="sub">Acquisition Hub</div>
  </div>
  <div class="nsec">
    <div class="nlabel">Programs</div>
    <div class="psw" id="prog-sw"></div>
    <div style="padding:0 12px"><button class="addprog" onclick="openModal('m-new-prog')">+ New program</button></div>
  </div>
