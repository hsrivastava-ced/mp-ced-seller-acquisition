function saveSetup() {
  const url = document.getElementById('setup-url').value.trim().replace(/\/$/, '');
  const key = document.getElementById('setup-key').value.trim();
  if (!url || !key) { document.getElementById('setup-msg').innerHTML = '<div class="info-box amber">Please enter both URL and key.</div>'; return; }
  localStorage.setItem(CFG_KEY, JSON.stringify({url, key}));
  SB_URL = url; SB_KEY = key;
  document.getElementById('setup-msg').innerHTML = '<div class="info-box teal">Connecting...</div>';
  initApp();
}

// ============================================================
// INIT & DATA LOAD
// ============================================================
async function initApp() {
  const cfg = JSON.parse(localStorage.getItem(CFG_KEY)||'null');
  if (!cfg || !cfg.url || !cfg.key) {
    document.getElementById('loading').classList.add('hidden');
    document.getElementById('setup-screen').style.display = 'flex';
    return;
  }
  SB_URL = cfg.url; SB_KEY = cfg.key;
  document.getElementById('loading').classList.remove('hidden');
  document.getElementById('loading-text').textContent = 'Connecting to database...';
  try {
    await refreshAll(true);
    document.getElementById('loading').classList.add('hidden');
    document.getElementById('setup-screen').style.display = 'none';
    document.getElementById('app').style.display = 'flex';
    setDBStatus('ok');
    renderProgs();
    if (PROGRAMS.length > 0) { CUR_PROG = PROGRAMS[0].id; }
    renderView();
  } catch(e) {
    document.getElementById('loading').classList.add('hidden');
    // Check if it's a fresh DB (no programs) or a real error
    if (e.message && e.message.includes('relation') && e.message.includes('does not exist')) {
      document.getElementById('setup-screen').style.display = 'flex';
      document.getElementById('setup-msg').innerHTML = '<div class="info-box amber">Tables not found. Please run the SQL schema first, then try again.</div>';
    } else {
      document.getElementById('setup-screen').style.display = 'flex';
      document.getElementById('setup-msg').innerHTML = '<div class="info-box amber">Connection failed: ' + e.message + '</div>';
    }
  }
}

async function refreshAll(init=false) {
  if (init) document.getElementById('loading-text').textContent = 'Loading programs...';
  PROGRAMS   = await sbFetch('programs?select=*&order=name');
  SELLERS    = await sbFetch('sellers?select=*&order=created_at.desc');
  QUALIFIED  = await sbFetch('qualified_sellers?select=*&order=created_at.asc');
  CAMPAIGNS  = await sbFetch('campaigns?select=*&order=campaign_date.desc');
  PAYMENTS   = await sbFetch('payments?select=*&order=created_at.asc');
  MQL_EMAILS = JSON.parse(localStorage.getItem('ced_mql_emails')||'[]');
  if (!init) { renderProgs(); renderView(); toast('Data refreshed'); }
}

