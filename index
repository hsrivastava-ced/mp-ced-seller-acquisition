    body: `Hi [NAME],\n\nI am following up from CedCommerce regarding your Temu onboarding. Please let me know if there is anything I can help with.\n\nBest,\n[YOUR NAME]\nCedCommerce`
  }
};

function getTpl(status) { return ETPL[status] || ETPL['DEFAULT']; }

function openEmail(email, company, status) {
  if (!email || email.includes('@update')) { toast('No email available for this seller', true); return; }
  const t = getTpl(status);
  const nm = (company || 'there').split(' ')[0];
  const sub = encodeURIComponent(t.sub.replace(/\[STORE\]/g, company||'').replace(/\[NAME\]/g, nm));
  const body = encodeURIComponent(t.body.replace(/\[STORE\]/g, company||'').replace(/\[NAME\]/g, nm));
  window.open('https://mail.google.com/mail/?view=cm&to=' + encodeURIComponent(email) + '&su=' + sub + '&body=' + body, '_blank');
}

function openWA(phone, company) {
  const nm = (company || 'there').split(' ')[0];
  const msg = encodeURIComponent('Hi ' + nm + ', following up from CedCommerce about your Temu onboarding. Do you have 10 minutes for a quick call?');
  window.open('https://wa.me/' + (phone||'').replace(/\D/g,'') + '?text=' + msg, '_blank');
}

