async function saveQualified() {
  populateForms();
  const store = document.getElementById('q-store').value.trim();
  if (!store) { alert('Store name required'); return; }
  const prog = curProg();
  const data = {
    id: uid(),
    program_id: CUR_PROG,
    store_name: store,
    email: document.getElementById('q-email').value.trim()||null,
    store_id: document.getElementById('q-sid').value.trim()||null,
    bda: document.getElementById('q-bda').value,
    first_sale_month: document.getElementById('q-month').value,
    amount: parseInt(document.getElementById('q-amt').value)||prog.incentive_amount||800,
    currency: prog.currency||'EUR',
    temu_paid_ced: document.getElementById('q-cedpaid').value,
    ced_paid_csa: document.getElementById('q-csapaid').value,
    bd_incentive: 'pending',
    notes: document.getElementById('q-notes').value
  };
  try {
    const res = await DB.from('qualified_sellers').insert(data);
